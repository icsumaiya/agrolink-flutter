	</div><style type="text/css">.wprm-recipe-template-as-2024-food-template {
    margin: 20px auto;
    background-color: #fafafa; /*wprm_background type=color*/
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif; /*wprm_main_font_family type=font*/
    font-size: 0.9em; /*wprm_main_font_size type=font_size*/
    line-height: 1.5em !important; /*wprm_main_line_height type=font_size*/
    color: #333333; /*wprm_main_text type=color*/
    max-width: 650px; /*wprm_max_width type=size*/
}
.wprm-recipe-template-as-2024-food-template a {
    color: #822f6c; /*wprm_link type=color*/
}
.wprm-recipe-template-as-2024-food-template p, .wprm-recipe-template-as-2024-food-template li {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif; /*wprm_main_font_family type=font*/
    font-size: 1em !important;
    line-height: 1.5em !important; /*wprm_main_line_height type=font_size*/
}
.wprm-recipe-template-as-2024-food-template li {
    margin: 0 0 0 32px !important;
    padding: 0 !important;
}
.rtl .wprm-recipe-template-as-2024-food-template li {
    margin: 0 32px 0 0 !important;
}
.wprm-recipe-template-as-2024-food-template ol, .wprm-recipe-template-as-2024-food-template ul {
    margin: 0 !important;
    padding: 0 !important;
}
.wprm-recipe-template-as-2024-food-template br {
    display: none;
}
.wprm-recipe-template-as-2024-food-template .wprm-recipe-name,
.wprm-recipe-template-as-2024-food-template .wprm-recipe-header {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif; /*wprm_header_font_family type=font*/
    color: #212121; /*wprm_header_text type=color*/
    line-height: 1.3em; /*wprm_header_line_height type=font_size*/
}
.wprm-recipe-template-as-2024-food-template h1,
.wprm-recipe-template-as-2024-food-template h2,
.wprm-recipe-template-as-2024-food-template h3,
.wprm-recipe-template-as-2024-food-template h4,
.wprm-recipe-template-as-2024-food-template h5,
.wprm-recipe-template-as-2024-food-template h6 {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen-Sans, Ubuntu, Cantarell, "Helvetica Neue", sans-serif; /*wprm_header_font_family type=font*/
    color: #212121; /*wprm_header_text type=color*/
    line-height: 1.3em; /*wprm_header_line_height type=font_size*/
    margin: 0 !important;
    padding: 0 !important;
}
.wprm-recipe-template-as-2024-food-template .wprm-recipe-header {
    margin-top: 1.2em !important;
}
.wprm-recipe-template-as-2024-food-template h1 {
    font-size: 2em; /*wprm_h1_size type=font_size*/
}
.wprm-recipe-template-as-2024-food-template h2 {
    font-size: 1.8em; /*wprm_h2_size type=font_size*/
}
.wprm-recipe-template-as-2024-food-template h3 {
    font-size: 1.2em; /*wprm_h3_size type=font_size*/
}
.wprm-recipe-template-as-2024-food-template h4 {
    font-size: 1em; /*wprm_h4_size type=font_size*/
}
.wprm-recipe-template-as-2024-food-template h5 {
    font-size: 1em; /*wprm_h5_size type=font_size*/
}
.wprm-recipe-template-as-2024-food-template h6 {
    font-size: 1em; /*wprm_h6_size type=font_size*/
}.wprm-recipe-template-as-2024-food-template {
	position: relative;
	border-style: solid; /*wprm_border_style type=border*/
	border-width: 1px; /*wprm_border_width type=size*/
	border-color: #aaaaaa; /*wprm_border type=color*/
	border-radius: 10px; /*wprm_border_radius type=size*/
	margin: 120px auto 20px auto;
	overflow: visible;
}
.wprm-recipe-template-as-2024-food-template-container {
	overflow: hidden;
	padding: 0 10px 10px 10px;
	border: 0;
	border-radius: 7px; /*wprm_inner_border_radius type=size*/
}
.wprm-recipe-template-as-2024-food-template .wprm-recipe-image {
	position: absolute;
	margin-top: -100px;
	margin-left: -100px;
	left: 50%;
}
.wprm-recipe-template-as-2024-food-template-header {
	margin: 0 -10px 10px -10px;
	padding: 110px 10px 10px 10px;
	text-align: center;
	background-color: #7ba695; /*wprm_top_header_background type=color*/
	color: #000000; /*wprm_top_header_text type=color*/
}
.wprm-recipe-template-as-2024-food-template-header a {
	color: #822f6c; /*wprm_top_header_link type=color*/
}
.wprm-recipe-template-as-2024-food-template-header .wprm-recipe-name {
	color: #000000; /*wprm_top_header_text type=color*/
}.wprm-recipe-template-as-2024-jump-button {
    font-family: inherit; /*wprm_font_family type=font*/
    font-size: 0.9em; /*wprm_font_size type=font_size*/
    text-align: center; /*wprm_text_align type=align*/
    margin-top: 0px; /*wprm_margin_top type=size*/
    margin-bottom: 10px; /*wprm_margin_bottom type=size*/
}
.wprm-recipe-template-as-2024-jump-button a  {
    margin: 5px; /*wprm_margin_button type=size*/
    margin: 5px; /*wprm_margin_button type=size*/
}

.wprm-recipe-template-as-2024-jump-button a:first-child {
    margin-left: 0;
}
.wprm-recipe-template-as-2024-jump-button a:last-child {
    margin-right: 0;
